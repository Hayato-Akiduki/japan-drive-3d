<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>JapanDrive</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- ゲームのバージョン。自動更新は GitHub のリリース（v1.1.0 など）と比べる -->
    <Version>1.2.0</Version>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Product>日本一周ドライブ3D</Product>
    <Company>Hayato-Akiduki</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="7.0.2" />
  </ItemGroup>

  <!-- 遊び方メモを配布フォルダにも入れる -->
  <ItemGroup>
    <None Include="遊び方.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- ゲームのウィンドウのアイコン -->
    <EmbeddedResource Include="icon.png" LogicalName="icon.png" />
  </ItemGroup>

  <!-- 2D版と同じ地図データ・ゲームルールを共有する -->
  <ItemGroup>
    <Compile Include="..\JapanDrive\MapData.cs" Link="Shared\MapData.cs" />
    <Compile Include="..\JapanDrive\JapanOutline.cs" Link="Shared\JapanOutline.cs" />
    <Compile Include="..\JapanDrive\JapanGeo.cs" Link="Shared\JapanGeo.cs" />
    <Compile Include="..\JapanDrive\Game.cs" Link="Shared\Game.cs" />
  </ItemGroup>

</Project>
